ADMIN_PASSWORD=change_me
ADMIN_TOKEN=change_me
CORS_ORIGIN=https://example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=change_me

# Optional alternatives if the host provides Railway-style names instead.
# MYSQLHOST=127.0.0.1
# MYSQLPORT=3306
# MYSQLDATABASE=railway
# MYSQLUSER=root
# MYSQLPASSWORD=change_me

TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=openai

# Optional. Increase only if the shared host has a slow DB connection.
MYSQL_CONNECT_TIMEOUT=5

# Optional cloud uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
